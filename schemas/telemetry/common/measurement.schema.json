{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "measurement_id",
    "value",
    "unit"
  ],
  "properties": {
    "measurement_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "value": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 4096
        },
        {
          "type": "boolean"
        },
        {
          "type": "object"
        },
        {
          "type": "array"
        }
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "UCUM-compatible unit where applicable. Use '1' for dimensionless values."
    },
    "raw_value": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "raw_unit": {
      "type": "string",
      "maxLength": 64
    },
    "normalisation": {
      "type": "object",
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "factor": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "reference": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}