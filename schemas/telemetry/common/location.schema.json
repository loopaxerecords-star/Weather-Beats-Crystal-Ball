{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "altitude_m": {
      "type": "number"
    },
    "coordinate_reference_system": {
      "const": "EPSG:4326"
    },
    "place_id": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "country_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    }
  },
  "required": [
    "latitude",
    "longitude",
    "coordinate_reference_system"
  ],
  "additionalProperties": false
}