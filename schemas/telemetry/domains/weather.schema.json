{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "weather Telemetry Schema",
  "allOf": [
    {
      "$ref": "#/$defs/eventCommon"
    },
    {
      "properties": {
        "domain": {
          "const": "weather"
        },
        "measurement": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "measurement_id": {
                  "enum": [
                    "air_temperature",
                    "feels_like_temperature",
                    "relative_humidity",
                    "precipitation",
                    "rainfall",
                    "wind_speed",
                    "wind_direction",
                    "wind_gust",
                    "surface_pressure",
                    "cloud_cover",
                    "visibility",
                    "uv_index",
                    "weather_code"
                  ]
                }
              }
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/weatherContext"
        }
      },
      "required": [
        "domain",
        "measurement",
        "context"
      ]
    }
  ],
  "unevaluatedProperties": false
}