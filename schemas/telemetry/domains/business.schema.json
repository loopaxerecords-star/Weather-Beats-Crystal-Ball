{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "business Telemetry Schema",
  "allOf": [
    {
      "$ref": "#/$defs/eventCommon"
    },
    {
      "properties": {
        "domain": {
          "const": "business"
        },
        "measurement": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "measurement_id": {
                  "enum": [
                    "revenue",
                    "cost",
                    "profit",
                    "order_count",
                    "customer_count",
                    "conversion_rate",
                    "inventory_level",
                    "delivery_time",
                    "customer_satisfaction",
                    "operational_efficiency"
                  ]
                }
              }
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/businessContext"
        }
      },
      "required": [
        "domain",
        "measurement",
        "context"
      ]
    }
  ],
  "unevaluatedProperties": false
}