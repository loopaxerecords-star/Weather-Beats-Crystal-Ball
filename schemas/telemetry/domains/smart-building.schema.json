{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "smartBuilding Telemetry Schema",
  "allOf": [
    {
      "$ref": "#/$defs/eventCommon"
    },
    {
      "properties": {
        "domain": {
          "const": "smart_building"
        },
        "measurement": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "measurement_id": {
                  "enum": [
                    "indoor_temperature",
                    "indoor_humidity",
                    "occupancy_count",
                    "co2_level",
                    "lighting_level",
                    "hvac_state",
                    "door_state",
                    "water_flow",
                    "building_energy_consumption"
                  ]
                }
              }
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/smartBuildingContext"
        }
      },
      "required": [
        "domain",
        "measurement",
        "context"
      ]
    }
  ],
  "unevaluatedProperties": false
}