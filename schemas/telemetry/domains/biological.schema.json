{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "biological Telemetry Schema",
  "allOf": [
    {
      "$ref": "#/$defs/eventCommon"
    },
    {
      "properties": {
        "domain": {
          "const": "biological"
        },
        "measurement": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "measurement_id": {
                  "enum": [
                    "heart_rate",
                    "respiration_rate",
                    "body_temperature",
                    "biomass",
                    "growth_rate",
                    "population_count",
                    "biodiversity_index",
                    "chlorophyll_content",
                    "biological_activity"
                  ]
                }
              }
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/biologicalContext"
        }
      },
      "required": [
        "domain",
        "measurement",
        "context"
      ]
    }
  ],
  "unevaluatedProperties": false
}