{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "oceanographic Telemetry Schema",
  "allOf": [
    {
      "$ref": "#/$defs/eventCommon"
    },
    {
      "properties": {
        "domain": {
          "const": "oceanographic"
        },
        "measurement": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "measurement_id": {
                  "enum": [
                    "sea_surface_temperature",
                    "sea_level",
                    "wave_height",
                    "wave_period",
                    "wave_direction",
                    "current_speed",
                    "current_direction",
                    "salinity",
                    "dissolved_oxygen",
                    "chlorophyll",
                    "tide_level"
                  ]
                }
              }
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/oceanographicContext"
        }
      },
      "required": [
        "domain",
        "measurement",
        "context"
      ]
    }
  ],
  "unevaluatedProperties": false
}