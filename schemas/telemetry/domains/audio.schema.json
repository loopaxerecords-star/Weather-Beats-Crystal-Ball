{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "audio Telemetry Schema",
  "allOf": [
    {
      "$ref": "#/$defs/eventCommon"
    },
    {
      "properties": {
        "domain": {
          "const": "audio"
        },
        "measurement": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "measurement_id": {
                  "enum": [
                    "peak_amplitude",
                    "rms_level",
                    "loudness_lufs",
                    "true_peak",
                    "spectral_centroid",
                    "spectral_bandwidth",
                    "spectral_rolloff",
                    "spectral_flatness",
                    "zero_crossing_rate",
                    "frequency_peak",
                    "noise_floor",
                    "stereo_width"
                  ]
                }
              }
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/audioContext"
        }
      },
      "required": [
        "domain",
        "measurement",
        "context"
      ]
    }
  ],
  "unevaluatedProperties": false
}