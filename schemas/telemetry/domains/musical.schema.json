{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "musical Telemetry Schema",
  "allOf": [
    {
      "$ref": "#/$defs/eventCommon"
    },
    {
      "properties": {
        "domain": {
          "const": "musical"
        },
        "measurement": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "measurement_id": {
                  "enum": [
                    "tempo_bpm",
                    "beat_position",
                    "onset_strength",
                    "pitch_hz",
                    "midi_note",
                    "key_estimate",
                    "time_signature",
                    "chord_estimate",
                    "rhythm_density",
                    "note_velocity",
                    "bar_position",
                    "musical_section"
                  ]
                }
              }
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/musicalContext"
        }
      },
      "required": [
        "domain",
        "measurement",
        "context"
      ]
    }
  ],
  "unevaluatedProperties": false
}