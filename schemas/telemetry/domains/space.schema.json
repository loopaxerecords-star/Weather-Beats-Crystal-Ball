{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "space Telemetry Schema",
  "allOf": [
    {
      "$ref": "#/$defs/eventCommon"
    },
    {
      "properties": {
        "domain": {
          "const": "space"
        },
        "measurement": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "measurement_id": {
                  "enum": [
                    "satellite_position",
                    "orbital_altitude",
                    "orbital_velocity",
                    "radiation_flux",
                    "proton_flux",
                    "electron_flux",
                    "geomagnetic_storm_level",
                    "space_debris_distance",
                    "solar_particle_event"
                  ]
                }
              }
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/spaceContext"
        }
      },
      "required": [
        "domain",
        "measurement",
        "context"
      ]
    }
  ],
  "unevaluatedProperties": false
}