{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "financial Telemetry Schema",
  "allOf": [
    {
      "$ref": "#/$defs/eventCommon"
    },
    {
      "properties": {
        "domain": {
          "const": "financial"
        },
        "measurement": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "measurement_id": {
                  "enum": [
                    "asset_price",
                    "bid_price",
                    "ask_price",
                    "trade_volume",
                    "market_capitalisation",
                    "exchange_rate",
                    "yield",
                    "volatility",
                    "index_value",
                    "transaction_value"
                  ]
                }
              }
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/financialContext"
        }
      },
      "required": [
        "domain",
        "measurement",
        "context"
      ]
    }
  ],
  "unevaluatedProperties": false
}