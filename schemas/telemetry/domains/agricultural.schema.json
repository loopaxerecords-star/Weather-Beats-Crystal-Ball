{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agricultural Telemetry Schema",
  "allOf": [
    {
      "$ref": "#/$defs/eventCommon"
    },
    {
      "properties": {
        "domain": {
          "const": "agricultural"
        },
        "measurement": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "measurement_id": {
                  "enum": [
                    "soil_moisture",
                    "soil_temperature",
                    "soil_ph",
                    "soil_nitrogen",
                    "soil_phosphorus",
                    "soil_potassium",
                    "crop_growth",
                    "yield_estimate",
                    "irrigation_rate",
                    "leaf_wetness",
                    "evapotranspiration"
                  ]
                }
              }
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/agriculturalContext"
        }
      },
      "required": [
        "domain",
        "measurement",
        "context"
      ]
    }
  ],
  "unevaluatedProperties": false
}