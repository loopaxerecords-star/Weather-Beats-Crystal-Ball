{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "economic Telemetry Schema",
  "allOf": [
    {
      "$ref": "#/$defs/eventCommon"
    },
    {
      "properties": {
        "domain": {
          "const": "economic"
        },
        "measurement": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "measurement_id": {
                  "enum": [
                    "inflation_rate",
                    "unemployment_rate",
                    "gross_domestic_product",
                    "interest_rate",
                    "consumer_price_index",
                    "producer_price_index",
                    "trade_balance",
                    "government_debt",
                    "industrial_production",
                    "consumer_confidence"
                  ]
                }
              }
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/economicContext"
        }
      },
      "required": [
        "domain",
        "measurement",
        "context"
      ]
    }
  ],
  "unevaluatedProperties": false
}