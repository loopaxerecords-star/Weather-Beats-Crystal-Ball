{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "energy Telemetry Schema",
  "allOf": [
    {
      "$ref": "#/$defs/eventCommon"
    },
    {
      "properties": {
        "domain": {
          "const": "energy"
        },
        "measurement": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "measurement_id": {
                  "enum": [
                    "power",
                    "energy",
                    "voltage",
                    "current",
                    "frequency",
                    "power_factor",
                    "energy_generation",
                    "energy_consumption",
                    "solar_generation",
                    "battery_state_of_charge",
                    "grid_import",
                    "grid_export"
                  ]
                }
              }
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/energyContext"
        }
      },
      "required": [
        "domain",
        "measurement",
        "context"
      ]
    }
  ],
  "unevaluatedProperties": false
}