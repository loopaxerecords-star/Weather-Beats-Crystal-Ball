{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "transport Telemetry Schema",
  "allOf": [
    {
      "$ref": "#/$defs/eventCommon"
    },
    {
      "properties": {
        "domain": {
          "const": "transport"
        },
        "measurement": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "measurement_id": {
                  "enum": [
                    "vehicle_speed",
                    "vehicle_position",
                    "vehicle_heading",
                    "traffic_flow",
                    "traffic_density",
                    "travel_time",
                    "vehicle_count",
                    "fuel_consumption",
                    "battery_range",
                    "route_delay"
                  ]
                }
              }
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/transportContext"
        }
      },
      "required": [
        "domain",
        "measurement",
        "context"
      ]
    }
  ],
  "unevaluatedProperties": false
}