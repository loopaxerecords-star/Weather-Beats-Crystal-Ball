{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "geographic Telemetry Schema",
  "allOf": [
    {
      "$ref": "#/$defs/eventCommon"
    },
    {
      "properties": {
        "domain": {
          "const": "geographic"
        },
        "measurement": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "measurement_id": {
                  "enum": [
                    "latitude",
                    "longitude",
                    "elevation",
                    "distance",
                    "area",
                    "population_density",
                    "slope",
                    "aspect",
                    "land_cover_class",
                    "boundary_change"
                  ]
                }
              }
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/geographicContext"
        }
      },
      "required": [
        "domain",
        "measurement",
        "context"
      ]
    }
  ],
  "unevaluatedProperties": false
}