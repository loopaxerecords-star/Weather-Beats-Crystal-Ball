{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "network Telemetry Schema",
  "allOf": [
    {
      "$ref": "#/$defs/eventCommon"
    },
    {
      "properties": {
        "domain": {
          "const": "network"
        },
        "measurement": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "measurement_id": {
                  "enum": [
                    "latency",
                    "packet_loss",
                    "bandwidth",
                    "throughput",
                    "jitter",
                    "connection_count",
                    "signal_strength",
                    "network_availability",
                    "error_rate"
                  ]
                }
              }
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/networkContext"
        }
      },
      "required": [
        "domain",
        "measurement",
        "context"
      ]
    }
  ],
  "unevaluatedProperties": false
}