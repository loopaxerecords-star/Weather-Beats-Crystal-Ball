{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "environmental Telemetry Schema",
  "allOf": [
    {
      "$ref": "#/$defs/eventCommon"
    },
    {
      "properties": {
        "domain": {
          "const": "environmental"
        },
        "measurement": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "measurement_id": {
                  "enum": [
                    "pm1",
                    "pm2_5",
                    "pm10",
                    "carbon_dioxide",
                    "carbon_monoxide",
                    "nitrogen_dioxide",
                    "sulphur_dioxide",
                    "ozone",
                    "noise_level",
                    "water_quality",
                    "soil_contamination",
                    "radiation_level"
                  ]
                }
              }
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/environmentalContext"
        }
      },
      "required": [
        "domain",
        "measurement",
        "context"
      ]
    }
  ],
  "unevaluatedProperties": false
}