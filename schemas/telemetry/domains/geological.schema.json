{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "geological Telemetry Schema",
  "allOf": [
    {
      "$ref": "#/$defs/eventCommon"
    },
    {
      "properties": {
        "domain": {
          "const": "geological"
        },
        "measurement": {
          "allOf": [
            {
              "$ref": "#/$defs/measurement"
            },
            {
              "properties": {
                "measurement_id": {
                  "enum": [
                    "earthquake_magnitude",
                    "seismic_acceleration",
                    "seismic_velocity",
                    "ground_displacement",
                    "depth",
                    "volcanic_activity",
                    "gas_emission",
                    "ground_temperature",
                    "landslide_displacement"
                  ]
                }
              }
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/geologicalContext"
        }
      },
      "required": [
        "domain",
        "measurement",
        "context"
      ]
    }
  ],
  "unevaluatedProperties": false
}